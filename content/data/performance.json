 "notes": [
  {
   "item": "Source",
   "note": "Per-glider NetCDF files converted from the Glider Rodeo CSV exports; glider specifications from PAM_Glider_Specs.csv."
  },
  {
   "item": "W h/dive",
   "note": "Amp-hours x pack voltage. Seagliders: nominal 24 V and 10 V packs. Slocums: each glider's own median measured voltage."
  },
  {
   "item": "Watts",
   "note": "Mean power draw over a dive: watt-hours used divided by dive duration in hours."
  },
  {
   "item": "Period measured",
   "note": "Span of the energy record against the span of the whole deployment. risso and capex987 engineering data stop on 10 Feb while their CTDs keep recording."
  },
  {
   "item": "Dives",
   "note": "Seagliders: dives in the GPS file. belladonna: dives in dives_with_status.csv. Slocums: intervals between surfacings, keeping those deeper than 100 m and longer than 30 min."
  },
  {
   "item": "SEA117",
   "note": "Reports battery voltage only, with no charge counter, so energy use cannot be derived."
  },
  {
   "item": "belladonna",
   "note": "No flight/engineering export (no pitch, roll or buoyancy), but since 16 Sep it has a power log: current, voltage, power and cumulative energy every 25 s, plus per-dive battery percentage and free disk space."
  },
  {
   "item": "capex987",
   "note": "Energy use is about 2.4x its sister Slocums; its JASCO OceanObserver records 5 channels from 4 hydrophones (one at 512 kHz) against a single channel on the others."
  },
  {
   "item": "Preliminary",
   "note": "All rodeo data are marked PRELIMINARY and need further QA/QC."
  },
  {
   "item": "Mission modes",
   "note": "Rodeo fieldwork plan (UTC). A dive belongs to the mode its start time falls in; rows are labelled by their own timestamp."
  },
  {
   "item": "belladonna vert speed",
   "note": "Not trustworthy: its CTD timestamps arrive in bursts (samples under 1 ms apart), so rates computed between samples are far too high."
  },
  {
   "item": "km per hour",
   "note": "Straight-line distance over ground between the start and end of a dive, divided by dive duration. It is not speed through water and ignores what the glider did in between."
  },
  {
   "item": "cc pumped per dive",
   "note": "Same measure summed over one dive, then the median across the dives of that mode. Counts travel in both directions: a dive that pumps 400 cc down and 400 cc back up counts as 800 cc."
  },
  {
   "item": "cc pumped per hour",
   "note": "Total volume the buoyancy pump moved per hour, summing |change| between samples (Seaglider VBD, Slocum oil volume, SeaExplorer ballast). Changes under 1 cc are treated as sensor noise. A proxy for pump work; the gliders do not report pump energy."
  }
