      "source": [
        "---\n",
        "title: Glider Performance\n",
        "page-layout: full\n",
        "toc: false\n",
        "resources:\n",
        "  - data/glider_performance_summary.csv\n",
        "format:\n",
        "  html:\n",
        "    include-in-header:\n",
        "      text: |\n",
        "        <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap\">\n",
        "jupyter:\n",
        "  jupytext:\n",
        "    text_representation:\n",
        "      extension: .qmd\n",
        "      format_name: quarto\n",
        "      format_version: '1.0'\n",
        "      jupytext_version: 1.19.1\n",
        "  kernelspec:\n",
        "    display_name: Python 3 (ipykernel)\n",
        "    language: python\n",
        "    name: python3\n",
        "---\n",
        "\n",
        "```{=html}\n",
        "<style>\n",
        "  :root {\n",
        "    --page: #FFFFFF;\n",
        "    --sidebar: #D9E3E4;\n",
        "    --surface: #FFFFFF;\n",
        "    --surface-2: #F1F6F7;\n",
        "    --line: #DAE3E5;\n",
        "    --line-strong: #BCCBCE;\n",
        "    --ink: #1F2C31;\n",
        "    --ink-2: #536268;\n",
        "    --ink-3: #78888E;\n",
        "    --accent: #2780E3;\n",
        "    --accent-ink: #1B62B0;\n",
        "    --accent-soft: #E3EEFB;\n",
        "    --measured: #1A6B4E;\n",
        "    --measured-soft: #DCEDE4;\n",
        "    --vendor: #56666D;\n",
        "    --vendor-soft: #E9EEEF;\n",
        "    --derived: #86570A;\n",
        "    --derived-soft: #F6E9CF;\n",
        "    --flag: #A33227;\n",
        "    --flag-soft: #F8E4E1;\n",
        "    --track: #E2E9EA;\n",
        "    --shadow: 0 1px 2px rgba(31, 44, 49, .05), 0 6px 18px rgba(31, 44, 49, .07);\n",
        "    --sans: \"Atkinson Hyperlegible\", \"Helvetica Neue\", Arial, sans-serif;\n",
        "    --mono: ui-monospace, \"SFMono-Regular\", \"Cascadia Mono\", Menlo, Consolas, monospace;\n",
        "  }\n",
        "  body.quarto-dark, :root[data-bs-theme=\"dark\"] {\n",
        "      --page: #181818;\n",
        "      --sidebar: #303030;\n",
        "      --surface: #212121;\n",
        "      --surface-2: #2A2A2A;\n",
        "      --line: #3A3A3A;\n",
        "      --line-strong: #4E4E4E;\n",
        "      --ink: #F2F2F2;\n",
        "      --ink-2: #BFC6C8;\n",
        "      --ink-3: #939A9D;\n",
        "      --accent: #75AADB;\n",
        "      --accent-ink: #9CC6EC;\n",
        "      --accent-soft: #23323F;\n",
        "      --measured: #6DC49B;\n",
        "      --measured-soft: #1B2F27;\n",
        "      --vendor: #A6B1B5;\n",
        "      --vendor-soft: #2C2C2C;\n",
        "      --derived: #DCA847;\n",
        "      --derived-soft: #342A12;\n",
        "      --flag: #E08278;\n",
        "      --flag-soft: #3A211E;\n",
        "      --track: #333;\n",
        "      --shadow: 0 1px 2px rgba(0, 0, 0, .5), 0 8px 22px rgba(0, 0, 0, .4);\n",
        "  }\n",
        "\n",
        "  #gsd * { box-sizing: border-box; }\n",
        "  #gsd {\n",
        "    max-width: 1100px; color: var(--ink); font-family: var(--sans);\n",
        "    font-size: 15px; line-height: 1.55;\n",
        "  }\n",
        "  #gsd h1, #gsd h2, #gsd h3, #gsd h4 { margin: 0; font-weight: 700; text-wrap: balance; }\n",
        "  #gsd a { color: var(--accent); }\n",
        "  #gsd .control select[multiple] {min-height:110px;}\n",
        "\n",
        "  #gsd .page-head { border-bottom: 1px solid var(--line); padding-bottom: 14px; margin-bottom: 22px; }\n",
        "  #gsd .page-head p { margin: 8px 0 0; color: var(--ink-2); max-width: 72ch; }\n",
        "\n",
        "  #gsd h2.section { font-size: 19px; margin: 30px 0 4px; }\n",
        "  #gsd h2.section:first-of-type { margin-top: 8px; }\n",
        "  #gsd .section-note { margin: 0 0 14px; color: var(--ink-2); font-size: 14px; }\n",
        "\n",
        "  /* ---------- panel: mission parameters ---------- */\n",
        "  #gsd .panel { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 18px; box-shadow: var(--shadow); }\n",
        "  #gsd .panel h3 { font-size: 13px; text-transform: uppercase; letter-spacing: .07em; color: var(--ink-3); margin-bottom: 10px; }\n",
        "  #gsd .caps { display: flex; flex-wrap: wrap; gap: 8px; }\n",
        "  #gsd .cap {\n",
        "    display: inline-flex; align-items: center; gap: 7px; cursor: pointer;\n",
        "    border: 1px solid var(--line-strong); border-radius: 999px; padding: 6px 13px 6px 10px;\n",
        "    font-size: 13.5px; color: var(--ink-2); background: var(--surface); user-select: none;\n",
        "  }\n",
        "  #gsd .cap input { accent-color: var(--accent); margin: 0; }\n",
        "  #gsd .cap:has(input:checked) { background: var(--accent-soft); border-color: var(--accent); color: var(--accent-ink); font-weight: 700; }\n",
        "  #gsd .cap:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }\n",
        "\n",
        "  #gsd .slider-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(258px, 1fr)); gap: 14px 26px; margin-top: 6px; }\n",
        "  #gsd .sl { display: grid; grid-template-columns: auto 1fr auto; gap: 6px 10px; align-items: center; }\n",
        "  #gsd .sl .lab { grid-column: 1 / -1; display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--ink-2); }\n",
        "  #gsd .sl .lab input { accent-color: var(--accent); }\n",
        "  #gsd .sl .lab b { color: var(--ink); font-weight: 700; }\n",
        "  #gsd .sl .lab .val { margin-left: auto; font-family: var(--mono); font-size: 13px; color: var(--ink); font-variant-numeric: tabular-nums; }\n",
        "  #gsd .sl .end { font-family: var(--mono); font-size: 11px; color: var(--ink-3); }\n",
        "  #gsd .sl input[type=\"range\"] { width: 100%; accent-color: var(--accent); }\n",
        "  #gsd .sl.off { opacity: .48; }\n",
        "  #gsd .panel-actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line); }\n",
        "  #gsd .btn {\n",
        "    font: inherit; font-weight: 700; cursor: pointer; border-radius: 7px; padding: 8px 18px;\n",
        "    border: 1px solid var(--accent); background: var(--accent); color: #fff;\n",
        "  }\n",
        "  #gsd .btn.ghost { background: transparent; color: var(--accent-ink); }\n",
        "  #gsd .btn:focus-visible, #gsd .toggle button:focus-visible, #gsd .cap:focus-within, #gsd summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\n",
        "  #gsd .dirty { font-size: 13px; color: var(--derived); }\n",
        "  \n",
        "  #gsd .control-grid {display: grid;grid-template-columns: repeat(4, minmax(0, 1fr));gap: 14px;}\n",
        "  #gsd .control {display: flex;flex-direction: column;gap: 6px;}\n",
        "  #gsd .control > span {font-size: 11px;text-transform: uppercase;letter-spacing: .06em;color: var(--ink-3);font-weight: 700;}\n",
        "  #gsd .control select {width: 100%;font: inherit;font-size: 13px;color: var(--ink);background: var(--surface);border: 1px solid var(--line-strong);border-radius: 7px;padding: 8px 10px;}\n",
        "  #gsd .control select:focus {outline: 2px solid var(--accent);outline-offset: 2px;}\n",
        "\n",
        "  /* ---------- results ---------- */\n",
        "  #gsd .results-bar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 14px; }\n",
        "  #gsd .results-bar .count { font-size: 14px; color: var(--ink-2); }\n",
        "  #gsd .results-bar .count b { color: var(--ink); }\n",
        "  #gsd .toggle { display: inline-flex; border: 1px solid var(--line-strong); border-radius: 7px; overflow: hidden; margin-left: auto; }\n",
        "  #gsd .toggle button {\n",
        "    font: inherit; font-size: 13px; cursor: pointer; border: 0; background: var(--surface);\n",
        "    color: var(--ink-2); padding: 6px 14px;\n",
        "  }\n",
        "  #gsd .toggle button[aria-pressed=\"true\"] { background: var(--accent); color: #fff; font-weight: 700; }\n",
        "\n",
        "  #gsd .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 16px; }\n",
        "  #gsd .gcard { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; }\n",
        "  #gsd .gcard:hover { box-shadow: var(--shadow); }\n",
        "  #gsd .photo { aspect-ratio: 16 / 9; background: var(--surface-2); position: relative; }\n",
        "  #gsd .photo img { width: 100%; height: 100%; object-fit: cover; display: block; }\n",
        "  #gsd .photo .ribbon {\n",
        "    position: absolute; left: 10px; bottom: 10px; display: inline-flex; align-items: center; gap: 5px;\n",
        "    font-size: 11px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase;\n",
        "    background: var(--measured); color: #fff; border-radius: 4px; padding: 3px 8px;\n",
        "  }\n",
        "  #gsd .gbody { padding: 14px; display: flex; flex-direction: column; gap: 11px; flex: 1; }\n",
        "  #gsd .gname { display: flex; gap: 10px; justify-content: space-between; align-items: baseline; }\n",
        "  #gsd .gname h3 { font-size: 17px; }\n",
        "  #gsd .gname .maker { font-size: 12px; color: var(--ink-3); }\n",
        "  #gsd .affordance { margin: 0; font-size: 13px; color: var(--ink-2); }\n",
        "\n",
        "  #gsd .meter { display: grid; grid-template-columns: 74px 1fr auto; gap: 9px; align-items: center; }\n",
        "  #gsd .meter .k { font-size: 11px; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-3); }\n",
        "  #gsd .track { height: 6px; border-radius: 3px; background: var(--track); overflow: hidden; }\n",
        "  #gsd .track.none { background: repeating-linear-gradient(90deg, var(--track) 0 5px, transparent 5px 10px); }\n",
        "  #gsd .track span { display: block; height: 100%; background: var(--accent); border-radius: 3px; }\n",
        "  #gsd .track span.over { background-image: repeating-linear-gradient(115deg,\n",
        "    rgba(255, 255, 255, .5) 0 3px, transparent 3px 8px); }\n",
        "  #gsd .meter .v { font-family: var(--mono); font-size: 12px; font-variant-numeric: tabular-nums; }\n",
        "  #gsd .meter .v.dim { color: var(--ink-3); }\n",
        "\n",
        "  #gsd .chips { display: flex; flex-wrap: wrap; gap: 6px; }\n",
        "  #gsd .chip { font-family: var(--mono); font-size: 11px; background: var(--surface-2); color: var(--ink-2); border-radius: 5px; padding: 3px 7px; }\n",
        "  #gsd .fit { border-top: 1px solid var(--line); padding-top: 10px; display: flex; flex-direction: column; gap: 6px; }\n",
        "  #gsd .fit-row { display: flex; gap: 8px; align-items: flex-start; font-size: 12.5px; color: var(--ink-2); }\n",
        "  #gsd .fit-row .ic { flex: 0 0 auto; font-weight: 700; font-family: var(--mono); }\n",
        "  #gsd .fit-row.ok .ic { color: var(--measured); }\n",
        "  #gsd .fit-row.warn .ic { color: var(--flag); }\n",
        "  #gsd .fit-row.unknown .ic { color: var(--ink-3); }\n",
        "  #gsd .fit-row b { color: var(--ink); font-weight: 700; }\n",
        "\n",
        "  #gsd .badge {\n",
        "    display: inline-flex; align-items: center; gap: 5px; font-size: 10.5px; font-weight: 700;\n",
        "    letter-spacing: .04em; text-transform: uppercase; border-radius: 4px; padding: 3px 7px;\n",
        "  }\n",
        "  #gsd .badge .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }\n",
        "  #gsd .badge.measured { color: var(--measured); background: var(--measured-soft); }\n",
        "  #gsd .badge.vendor { color: var(--vendor); background: var(--vendor-soft); }\n",
        "  #gsd .badge.derived { color: var(--derived); background: var(--derived-soft); }\n",
        "  #gsd .badge.flag { color: var(--flag); background: var(--flag-soft); }\n",
        "\n",
        "  #gsd details.more { border-top: 1px solid var(--line); margin-top: auto; }\n",
        "  #gsd details.more summary {\n",
        "    cursor: pointer; list-style: none; padding: 9px 0 0; font-size: 12.5px; font-weight: 700;\n",
        "    color: var(--accent-ink);\n",
        "  }\n",
        "  #gsd details.more summary::-webkit-details-marker { display: none; }\n",
        "  #gsd details.more summary::after { content: \" ▸\"; }\n",
        "  #gsd details.more[open] summary::after { content: \" ▾\"; }\n",
        "  #gsd .more-body { padding-top: 8px; display: flex; flex-direction: column; gap: 12px; }\n",
        "  #gsd .spec { display: grid; grid-template-columns: 1fr auto; gap: 3px 10px; font-size: 12.5px; padding: 5px 0; border-bottom: 1px solid var(--line); }\n",
        "  #gsd .spec:last-of-type { border-bottom: 0; }\n",
        "  #gsd .spec .sk { color: var(--ink-2); }\n",
        "  #gsd .spec .sv { font-family: var(--mono); text-align: right; font-variant-numeric: tabular-nums; }\n",
        "  #gsd .note-list { margin: 0; padding-left: 16px; font-size: 12.5px; color: var(--ink-2); }\n",
        "  #gsd .note-list li { margin-bottom: 3px; }\n",
        "  #gsd .linkrow { display: flex; flex-wrap: wrap; gap: 6px; }\n",
        "  #gsd .linkrow a {\n",
        "    font-size: 12px; text-decoration: none; color: var(--accent-ink);\n",
        "    border: 1px solid var(--line-strong); border-radius: 999px; padding: 4px 10px; background: var(--surface);\n",
        "  }\n",
        "  #gsd .linkrow a:hover { background: var(--accent-soft); border-color: var(--accent); }\n",
        "\n",
        "  /* ---------- table view ---------- */\n",
        "  #gsd .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }\n",
        "  #gsd table { border-collapse: collapse; width: 100%; font-size: 13px; }\n",
        "  #gsd th, #gsd td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--line); white-space: nowrap; }\n",
        "  #gsd th { font-size: 11px; letter-spacing: .05em; text-transform: uppercase; color: var(--ink-3); background: var(--surface-2); position: sticky; top: 0; }\n",
        "  #gsd td.num { font-family: var(--mono); font-variant-numeric: tabular-nums; }\n",
        "  #gsd tbody tr:last-child td { border-bottom: 0; }\n",
        "  #gsd td .muted { color: var(--ink-3); }\n",
        "\n",
        "  /* ---------- comparison charts ---------- */\n",
        "  #gsd .charts { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 18px; }\n",
        "  #gsd .chart { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; }\n",
        "  #gsd .chart h4 { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-3); margin-bottom: 10px; }\n",
        "  #gsd .bar { display: grid; grid-template-columns: 96px 1fr auto; gap: 8px; align-items: center; margin-bottom: 7px; font-size: 12px; }\n",
        "  #gsd .bar .n { color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n",
        "  #gsd .bar .b { height: 10px; background: var(--track); border-radius: 3px; overflow: hidden; }\n",
        "  #gsd .bar .b span { display: block; height: 100%; background: var(--accent); border-radius: 3px; }\n",
        "  #gsd .bar .b.measured span { background: var(--measured); }\n",
        "  #gsd .bar .val { font-family: var(--mono); font-variant-numeric: tabular-nums; color: var(--ink); }\n",
        "  #gsd .bar.nodata .val { color: var(--ink-3); }\n",
        "  #gsd .chart .foot { font-size: 11.5px; color: var(--ink-3); margin-top: 8px; }\n",
        "  \n",
        "  /* ---------- Performance Plots ---------- */\n",
        "  #gsd .chart-heading {display: flex;justify-content: space-between;align-items: baseline;gap: 12px;margin-bottom: 10px;}\n",
        "  #gsd .chart-heading h4 {margin: 0;}\n",
        "  #gsd .chart-heading span {font-size: 12px;color: var(--ink-3);}\n",
        "  #gsd .heatmap {overflow-x: auto;}\n",
        "  #gsd .heatmap-grid {display: grid;gap: 3px;min-width: 650px;}\n",
        "  #gsd .heat-cell {min-height: 48px;display: flex;align-items: center;justify-content: center;border-radius: 4px;font-family: var(--mono);font-size: 11px;}\n",
        "  #gsd .heat-label {display: flex;align-items: center;font-size: 11px;color: var(--ink-2);padding: 4px 8px;}\n",
        "  #gsd .heat-header {justify-content: center;text-align: center;font-weight: 700;color: var(--ink-3);text-transform: uppercase;letter-spacing: .04em;}\n",
        "\n",
        "  #gsd .empty { background: var(--surface-2); border: 1px dashed var(--line-strong); border-radius: 10px; padding: 20px; color: var(--ink-2); }\n",
        "\n",
        "  #gsd details.schema { margin-top: 30px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); padding: 14px 16px; }\n",
        "  #gsd details.schema > summary { cursor: pointer; font-weight: 700; font-size: 14px; }\n",
        "  #gsd details.schema .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; margin-top: 12px; }\n",
        "  #gsd details.schema .f { border-left: 3px solid var(--accent); padding-left: 10px; }\n",
        "  #gsd details.schema .f b { font-family: var(--mono); font-size: 12.5px; }\n",
        "  #gsd details.schema .f p { margin: 2px 0 0; font-size: 12.5px; color: var(--ink-2); }\n",
        "\n",
        "  #gsd footer.credits { margin-top: 34px; border-top: 1px solid var(--line); padding-top: 14px; font-size: 12.5px; color: var(--ink-3); }\n",
        "  #gsd footer.credits a { color: var(--accent); }\n",
        "  #gsd .legend { display: flex; flex-wrap: wrap; gap: 10px 18px; align-items: center; margin: 14px 0 0; font-size: 12.5px; color: var(--ink-2); }\n",
        "  \n",
        "  @media (max-width: 850px) {#gsd .control-grid {grid-template-columns: repeat(2, minmax(0, 1fr));}}\n",
        "  @media (max-width: 560px) {#gsd .control-grid {grid-template-columns: 1fr;}}\n",
        "</style>\n",
        "\n",
        "<div id=\"gsd\">\n",
        "\n",
        "      <header class=\"page-head\">\n",
        "        <p>Comparing the PAM-equipped gliders of the\n",
        "          <a href=\"https://nmfs-pam-glider.github.io/GliderRodeo/\">NOAA Fisheries Glider Rodeo 2026</a>.\n",
        "          Same underlying page styling as the main page, just adding some plots and such here. Code copied from main page.</p>\n",
        "      </header>\n",
        "    \n",
        "      <!-- ---------- controls ---------- -->\n",
        "\n",
        "    <section class=\"panel performance-controls\">\n",
        "  \n",
        "      <h3>Performance filters</h3>\n",
        "  \n",
        "      <div class=\"control-grid\">\n",
        "  \n",
        "        <label class=\"control\">\n",
        "          <span>Glider</span>\n",
        "          <select id=\"glider-select\" multiple>\n",
        "            <option value=\"all\">All gliders</option>\n",
        "          </select>\n",
        "        </label>\n",
        "  \n",
        "        <label class=\"control\">\n",
        "          <span>Mode</span>\n",
        "          <select id=\"mode-select\" multiple>\n",
        "            <option value=\"all\">All modes</option>\n",
        "          </select>\n",
        "        </label>\n",
        "  \n",
        "        <label class=\"control\">\n",
        "          <span>Heatmap metric</span>\n",
        "          <select id=\"metric-select\">\n",
        "            <option value=\"wh_km\">Energy efficiency (Wh/km)</option>\n",
        "            <option value=\"watts\">Power (W)</option>\n",
        "            <option value=\"wh_dive\">Energy per dive (Wh)</option>\n",
        "            <option value=\"distance\">Distance per dive (km)</option>\n",
        "            <option value=\"dive_duration\">Dive duration (hr)</option>\n",
        "            <option value=\"vertical_speed\">Vertical speed (m/s)</option>\n",
        "          </select>\n",
        "        </label>\n",
        "  \n",
        "        <div class=\"control\">\n",
        "          <span>View</span>\n",
        "          <div class=\"toggle\">\n",
        "            <button id=\"view-gliders\" aria-pressed=\"true\">Gliders</button>\n",
        "            <button id=\"view-modes\" aria-pressed=\"false\">Modes</button>\n",
        "          </div>\n",
        "        </div>\n",
        "  \n",
        "      </div>\n",
        "      <header class=\"page-head\">\n",
        "        <p>Press \"ctrl\" to select multiple glider options. </p>\n",
        "      </header> \n",
        "      \n",
        "      <div class=\"panel-actions\">\n",
        "        <button class=\"btn primary\" id=\"apply-performance\">Apply</button>\n",
        "        <button class=\"btn ghost\" id=\"reset-performance\">Reset</button>\n",
        "        <span class=\"dirty\" id=\"performance-status\" hidden>\n",
        "          Filters changed — click Apply\n",
        "        </span>\n",
        "      </div>\n",
        "  \n",
        "      \n",
        "    </section>\n",
        "  \n",
        "    <!-- ---------- summary ---------- -->\n",
        "  \n",
        "    <div class=\"results-bar performance-summary\">\n",
        "  \n",
        "      <span class=\"count\" id=\"performance-count\">\n",
        "        Loading performance data…\n",
        "      </span>\n",
        "  \n",
        "    </div>\n",
        "    \n",
        "    <!-- ---------- X-Y plots ---------- -->\n",
        "\n",
        "    <section class=\"charts performance-charts\">\n",
        "    \n",
        "      <div class=\"chart\">\n",
        "        <h4>Power vs. vertical speed</h4>\n",
        "        <div id=\"chart-power-speed\"></div>\n",
        "        <p class=\"foot\">\n",
        "          Each point represents an observed glider/mode combination.\n",
        "        </p>\n",
        "      </div>\n",
        "    \n",
        "      <div class=\"chart\">\n",
        "        <h4>Dive duration vs. maximum depth</h4>\n",
        "        <div id=\"chart-duration-depth\"></div>\n",
        "        <p class=\"foot\">\n",
        "          Dive duration and maximum depth for the selected data.\n",
        "        </p>\n",
        "      </div>\n",
        "    \n",
        "    </section>\n",
        "    \n",
        "    <section class=\"charts performance-charts\">\n",
        "    \n",
        "      <div class=\"chart\">\n",
        "        <h4>Distance vs. energy per dive</h4>\n",
        "        <div id=\"chart-distance-energy\"></div>\n",
        "        <p class=\"foot\">\n",
        "          Each point represents an observed glider/mode combination.\n",
        "        </p>\n",
        "      </div>\n",
        "    \n",
        "      <div class=\"chart\">\n",
        "        <h4>Pump moves per hour vs. # of pumped dives</h4>\n",
        "        <div id=\"chart-pump-power\"></div>\n",
        "        <p class=\"foot\">Pump activity and the number of dives with counted pump activity.</p>\n",
        "      </div>\n",
        "    \n",
        "    </section>\n",
        "    \n",
        "    <!-- ---------- bar plots ---------- -->\n",
        "    \n",
        "    <section class=\"charts performance-charts\">\n",
        "    \n",
        "      <div class=\"chart\">\n",
        "        <h4>Energy efficiency</h4>\n",
        "        <div id=\"chart-whkm\"></div>\n",
        "        <p class=\"foot\">\n",
        "          Lower Wh/km indicates less energy used per kilometer traveled.\n",
        "        </p>\n",
        "      </div>\n",
        "    \n",
        "      <div class=\"chart\">\n",
        "        <h4>Power</h4>\n",
        "        <div id=\"chart-watts\"></div>\n",
        "        <p class=\"foot\">\n",
        "          Observed power for each glider/mode combination.\n",
        "        </p>\n",
        "      </div>\n",
        "    \n",
        "    </section>\n",
        "    \n",
        "    <!-- ---------- heatmap ---------- -->\n",
        "    \n",
        "    <section class=\"chart performance-heatmap\">\n",
        "    \n",
        "      <div class=\"chart-heading\">\n",
        "        <h4>Mode comparison</h4>\n",
        "        <span id=\"heatmap-label\"></span>\n",
        "      </div>\n",
        "    \n",
        "      <div id=\"chart-heatmap\"></div>\n",
        "    \n",
        "    </section>\n",
        "    \n",
        "    <!-- ---------- detail table ---------- -->\n",
        "  \n",
        "    <section class=\"chart performance-table\">\n",
        "  \n",
        "      <div class=\"chart-heading\">\n",
        "        <h4>Performance data</h4>\n",
        "      </div>\n",
        "  \n",
        "      <div class=\"table-wrap\">\n",
        "        <table>\n",
        "          <thead id=\"performance-thead\"></thead>\n",
        "          <tbody id=\"performance-tbody\"></tbody>\n",
        "        </table>\n",
        "      </div>\n",
        "  \n",
        "    </section>\n",
        "\n",
        "</div>\n",
        "\n",
        "<script src=\"https://cdn.plot.ly/plotly-2.35.2.min.js\"></script>\n",
        "<script>\n",
        "let PERFORMANCE_DATA=[];let APPLIED_DATA=[];let COLUMNS={};\n",
        "\n",
        "function clean(value){\n",
        "  if(value===null||value===undefined)\n",
        "    return \"\";\n",
        "  return String(value).trim();\n",
        "}\n",
        "\n",
        "function number(value){\n",
        "  if(value===null||value===undefined||value===\"\")return null;\n",
        "  const n=Number(String(value).replace(/,/g,\"\").trim());\n",
        "  return Number.isFinite(n)?n:null;\n",
        "}\n",
        "\n",
        "function normalizeHeader(value){\n",
        "  return clean(value).toLowerCase().replace(/[^a-z0-9]/g,\"\");\n",
        "}\n",
        "\n",
        "function cssVar(name){\n",
        "  return getComputedStyle(document.body).getPropertyValue(name).trim();\n",
        "}\n",
        "\n",
        "function findColumn(rows,possibleNames){\n",
        "  if(!rows.length)return null;\n",
        "  const headers=Object.keys(rows[0]);\n",
        "  const normalized=headers.map(h=>({raw:h,norm:normalizeHeader(h)}));\n",
        "  for(const name of possibleNames){\n",
        "    const target=normalizeHeader(name);\n",
        "    const match=normalized.find(h=>h.norm===target);\n",
        "    if(match)return match.raw;\n",
        "  }\n",
        "  return null;\n",
        "}\n",
        "\n",
        "function getColumns(rows){\n",
        "  return{\n",
        "    glider:findColumn(rows,[\"glider\"]),\n",
        "    mode:findColumn(rows,[\"mode\"]),\n",
        "    wh_km:findColumn(rows,[\"W h per km\"]),\n",
        "    watts:findColumn(rows,[\"Watts\"]),\n",
        "    vertical_speed:findColumn(rows,[\"median |vert speed| m/s\"]),\n",
        "    dive_duration:findColumn(rows,[\"median dive h\"]),\n",
        "    max_depth:findColumn(rows,[\"median max depth m\",\"deepest in mode m\"]),\n",
        "    distance:findColumn(rows,[\"km/dive\"]),\n",
        "    wh_dive:findColumn(rows,[\"W h/dive\"]),\n",
        "    pump_moves:findColumn(rows,[\"pump moves per hour\"]),\n",
        "    pump_dives_counted:findColumn(rows,[\"pump dives counted\"]),\n",
        "    pump_volume:findColumn(rows,[\"cc pumped per hour\"])\n",
        "  };\n",
        "}\n",
        "\n",
        "const PLOT_COLORS={};\n",
        "let GLIDER_COLOR_MAP={};\n",
        "\n",
        "function gliderColor(name){\n",
        "  let hash=0;\n",
        "  for(let i=0;i<name.length;i++)\n",
        "    hash=(hash*31+name.charCodeAt(i))>>>0;\n",
        "  const hue=hash%360;\n",
        "  return `hsl(${hue},65%,45%)`;\n",
        "}\n",
        "\n",
        "function buildGliderColors(){\n",
        "  const gliders=[...new Set(PERFORMANCE_DATA.map(r=>clean(r[COLUMNS.glider])).filter(Boolean))];\n",
        "  GLIDER_COLOR_MAP={};\n",
        "  gliders.forEach(g=>GLIDER_COLOR_MAP[g]=gliderColor(g));\n",
        "}\n",
        "\n",
        "function refreshPlotColors(){\n",
        "  PLOT_COLORS.ink=cssVar(\"--ink\")||\"#1F2C31\";\n",
        "  PLOT_COLORS.ink2=cssVar(\"--ink-2\")||\"#536268\";\n",
        "  PLOT_COLORS.ink3=cssVar(\"--ink-3\")||\"#78888E\";\n",
        "  PLOT_COLORS.line=cssVar(\"--line\")||\"#DAE3E5\";\n",
        "  PLOT_COLORS.lineStrong=cssVar(\"--line-strong\")||\"#BCCBCE\";\n",
        "  PLOT_COLORS.accent=cssVar(\"--accent\")||\"#2780E3\";\n",
        "}\n",
        "\n",
        "const plotConfig={responsive:true,displayModeBar:false};\n",
        "\n",
        "function plotLayout(xTitle,yTitle){\n",
        "  return{\n",
        "    height:320,\n",
        "    margin:{l:65,r:20,t:10,b:55},\n",
        "    paper_bgcolor:\"rgba(0,0,0,0)\",\n",
        "    plot_bgcolor:\"rgba(0,0,0,0)\",\n",
        "    font:{family:\"Atkinson Hyperlegible, Arial, sans-serif\",color:PLOT_COLORS.ink},\n",
        "    xaxis:{title:xTitle,gridcolor:PLOT_COLORS.line,zerolinecolor:PLOT_COLORS.lineStrong},\n",
        "    yaxis:{title:yTitle,gridcolor:PLOT_COLORS.line,zerolinecolor:PLOT_COLORS.lineStrong},\n",
        "    hovermode:\"closest\"\n",
        "  };\n",
        "}\n",
        "\n",
        "function clearChart(id){\n",
        "  const el=document.getElementById(id);\n",
        "  if(el)el.innerHTML=\"\";\n",
        "}\n",
        "\n",
        "function showChartMessage(id,message){\n",
        "  const el=document.getElementById(id);\n",
        "  if(el)el.innerHTML=`<div class=\"empty\">${message}</div>`;\n",
        "}\n",
        "\n",
        "function validXY(rows,xCol,yCol){\n",
        "  return rows.map(r=>({\n",
        "    x:number(r[xCol]),\n",
        "    y:number(r[yCol]),\n",
        "    glider:clean(r[COLUMNS.glider]),\n",
        "    mode:clean(r[COLUMNS.mode])\n",
        "  })).filter(d=>d.x!==null&&d.y!==null);\n",
        "}\n",
        "\n",
        "async function loadPerformanceData(){\n",
        "  const status=document.getElementById(\"performance-count\");\n",
        "  status.textContent=\"Loading performance data…\";\n",
        "\n",
        "  try{\n",
        "    const response=await fetch(\"data/glider_performance_summary.csv\");\n",
        "    if(!response.ok)throw new Error(`Could not load CSV (${response.status} ${response.statusText})`);\n",
        "\n",
        "    const csvText=await response.text();\n",
        "    const lines=csvText.trim().split(/\\r?\\n/);\n",
        "    const headers=lines[0].split(\",\").map(h=>h.trim());\n",
        "\n",
        "    PERFORMANCE_DATA=lines.slice(1).map(line=>{\n",
        "      const values=line.split(\",\");\n",
        "      const row={};\n",
        "      headers.forEach((header,i)=>row[header]=values[i]!==undefined?values[i].trim():\"\");\n",
        "      return row;\n",
        "    }).filter(row=>Object.values(row).some(value=>clean(value)!==\"\"));\n",
        "\n",
        "    if(!PERFORMANCE_DATA.length)throw new Error(\"The CSV loaded, but contains no data rows.\");\n",
        "\n",
        "    COLUMNS=getColumns(PERFORMANCE_DATA);\n",
        "    console.log(\"Rows loaded:\",PERFORMANCE_DATA.length);\n",
        "    console.log(\"Detected columns:\",COLUMNS);\n",
        "    buildGliderColors();\n",
        "    populateFilters();\n",
        "    APPLIED_DATA=PERFORMANCE_DATA.slice();\n",
        "    refreshPlotColors();\n",
        "    renderDashboard();\n",
        "  }catch(error){\n",
        "    console.error(\"PERFORMANCE DASHBOARD ERROR:\",error);\n",
        "    status.innerHTML=`<span style=\"color:var(--flag);\">Unable to load performance data: ${error.message}</span>`;\n",
        "  }\n",
        "}\n",
        "\n",
        "function populateFilters(){\n",
        "  const gliderSelect=document.getElementById(\"glider-select\");\n",
        "  const modeSelect=document.getElementById(\"mode-select\");\n",
        "  const gliders=[...new Set(PERFORMANCE_DATA.map(r=>clean(r[COLUMNS.glider])).filter(Boolean))].sort();\n",
        "  const modes=[...new Set(PERFORMANCE_DATA.map(r=>clean(r[COLUMNS.mode])).filter(Boolean))].sort();\n",
        "\n",
        "  gliders.forEach(g=>{\n",
        "    const option=document.createElement(\"option\");\n",
        "    option.value=g;\n",
        "    option.textContent=g;\n",
        "    gliderSelect.appendChild(option);\n",
        "  });\n",
        "\n",
        "  modes.forEach(m=>{\n",
        "    const option=document.createElement(\"option\");\n",
        "    option.value=m;\n",
        "    option.textContent=m;\n",
        "    modeSelect.appendChild(option);\n",
        "  });\n",
        "\n",
        "  gliderSelect.options[0].selected=true;\n",
        "  modeSelect.options[0].selected=true;\n",
        "}\n",
        "\n",
        "function getFilteredData(){\n",
        "  const gliderSelect=document.getElementById(\"glider-select\");\n",
        "  const modeSelect=document.getElementById(\"mode-select\");\n",
        "\n",
        "  const selectedGliders=[...gliderSelect.selectedOptions].map(option=>option.value);\n",
        "  const selectedModes=[...modeSelect.selectedOptions].map(option=>option.value);\n",
        "\n",
        "  const allGliders=selectedGliders.includes(\"all\")||selectedGliders.length===0;\n",
        "  const allModes=selectedModes.includes(\"all\")||selectedModes.length===0;\n",
        "\n",
        "  return APPLIED_DATA.filter(r=>\n",
        "    (allGliders||selectedGliders.includes(clean(r[COLUMNS.glider])))&&\n",
        "    (allModes||selectedModes.includes(clean(r[COLUMNS.mode])))\n",
        "  );\n",
        "}\n",
        "\n",
        "function renderWhKm(rows){\n",
        "  clearChart(\"chart-whkm\");\n",
        "\n",
        "  const data=rows.map(r=>({\n",
        "    name:`${clean(r[COLUMNS.glider])} — ${clean(r[COLUMNS.mode])}`,\n",
        "    glider:clean(r[COLUMNS.glider]),\n",
        "    value:number(r[COLUMNS.wh_km])\n",
        "  })).filter(d=>d.value!==null).sort((a,b)=>a.value-b.value);\n",
        "\n",
        "  if(!data.length){\n",
        "    showChartMessage(\"chart-whkm\",\"No energy-efficiency data available.\");\n",
        "    return;\n",
        "  }\n",
        "\n",
        "  Plotly.newPlot(\"chart-whkm\",[{\n",
        "    type:\"bar\",\n",
        "    orientation:\"h\",\n",
        "    x:data.map(d=>d.value),\n",
        "    y:data.map(d=>d.name),\n",
        "    text:data.map(d=>d.value.toFixed(2)),\n",
        "    textposition:\"outside\",\n",
        "    marker:{color:data.map(d=>GLIDER_COLOR_MAP[d.glider])}\n",
        "  }],{\n",
        "    height:Math.max(320,data.length*28),\n",
        "    margin:{l:150,r:55,t:10,b:50},\n",
        "    paper_bgcolor:\"rgba(0,0,0,0)\",\n",
        "    plot_bgcolor:\"rgba(0,0,0,0)\",\n",
        "    font:{family:\"Atkinson Hyperlegible, Arial, sans-serif\",color:PLOT_COLORS.ink},\n",
        "    xaxis:{title:\"Wh/km\",gridcolor:PLOT_COLORS.line,zerolinecolor:PLOT_COLORS.lineStrong},\n",
        "    yaxis:{automargin:true}\n",
        "  },plotConfig);\n",
        "}\n",
        "\n",
        "function renderPowerSpeed(rows){\n",
        "  clearChart(\"chart-power-speed\");\n",
        "\n",
        "  const data=validXY(rows,COLUMNS.vertical_speed,COLUMNS.watts);\n",
        "\n",
        "  if(!data.length){\n",
        "    showChartMessage(\"chart-power-speed\",\"No power/vertical-speed data available.\");\n",
        "    return;\n",
        "  }\n",
        "\n",
        "  Plotly.newPlot(\"chart-power-speed\",[{\n",
        "    type:\"scatter\",\n",
        "    mode:\"markers\",\n",
        "    x:data.map(d=>d.x),\n",
        "    y:data.map(d=>d.y),\n",
        "    text:data.map(d=>`${d.glider} — ${d.mode}`),\n",
        "    hovertemplate:\"%{text}<br>Vertical speed: %{x:.3f} m/s<br>Power: %{y:.2f} W<extra></extra>\",\n",
        "    marker:{size:10,color:data.map(d=>GLIDER_COLOR_MAP[d.glider])}\n",
        "  }],plotLayout(\"Median |vertical speed| (m/s)\",\"Power (W)\"),plotConfig);\n",
        "}\n",
        "\n",
        "function renderDurationDepth(rows){\n",
        "  clearChart(\"chart-duration-depth\");\n",
        "\n",
        "  const data=validXY(rows,COLUMNS.dive_duration,COLUMNS.max_depth);\n",
        "\n",
        "  if(!data.length){\n",
        "    showChartMessage(\"chart-duration-depth\",\"No dive-duration/depth data available.\");\n",
        "    return;\n",
        "  }\n",
        "\n",
        "  Plotly.newPlot(\"chart-duration-depth\",[{\n",
        "    type:\"scatter\",\n",
        "    mode:\"markers\",\n",
        "    x:data.map(d=>d.x),\n",
        "    y:data.map(d=>d.y),\n",
        "    text:data.map(d=>`${d.glider} — ${d.mode}`),\n",
        "    hovertemplate:\"%{text}<br>Dive duration: %{x:.2f} hr<br>Maximum depth: %{y:.0f} m<extra></extra>\",\n",
        "    marker:{size:10,color:data.map(d=>GLIDER_COLOR_MAP[d.glider])}\n",
        "  }],plotLayout(\"Median dive duration (hr)\",\"Median maximum depth (m)\"),plotConfig);\n",
        "}\n",
        "\n",
        "function renderDistanceEnergy(rows){\n",
        "  clearChart(\"chart-distance-energy\");\n",
        "\n",
        "  const data=validXY(rows,COLUMNS.distance,COLUMNS.wh_dive);\n",
        "\n",
        "  if(!data.length){\n",
        "    showChartMessage(\"chart-distance-energy\",\"No distance/energy data available.\");\n",
        "    return;\n",
        "  }\n",
        "\n",
        "  Plotly.newPlot(\"chart-distance-energy\",[{\n",
        "    type:\"scatter\",\n",
        "    mode:\"markers\",\n",
        "    x:data.map(d=>d.x),\n",
        "    y:data.map(d=>d.y),\n",
        "    text:data.map(d=>`${d.glider} — ${d.mode}`),\n",
        "    hovertemplate:\"%{text}<br>Distance: %{x:.2f} km/dive<br>Energy: %{y:.2f} Wh/dive<extra></extra>\",\n",
        "    marker:{size:10,color:data.map(d=>GLIDER_COLOR_MAP[d.glider])}\n",
        "  }],plotLayout(\"Distance per dive (km)\",\"Energy per dive (Wh)\"),plotConfig);\n",
        "}\n",
        "\n",
        "function renderPumpPower(rows){\n",
        "  clearChart(\"chart-pump-power\");\n",
        "\n",
        "  const data=validXY(rows,COLUMNS.pump_moves,COLUMNS.pump_dives_counted);\n",
        "\n",
        "  if(!data.length){\n",
        "    showChartMessage(\"chart-pump-power\",\"No pump-activity data available.\");\n",
        "    return;\n",
        "  }\n",
        "\n",
        "  Plotly.newPlot(\"chart-pump-power\",[{\n",
        "    type:\"scatter\",\n",
        "    mode:\"markers\",\n",
        "    x:data.map(d=>d.x),\n",
        "    y:data.map(d=>d.y),\n",
        "    text:data.map(d=>`${d.glider} — ${d.mode}`),\n",
        "    hovertemplate:\"%{text}<br>Pump moves: %{x:.0f} / hr<br>Pumped dives counted: %{y:.0f}<extra></extra>\",\n",
        "    marker:{size:10,color:data.map(d=>GLIDER_COLOR_MAP[d.glider])}\n",
        "  }],plotLayout(\"Pump moves per hour\",\"Pumped dives counted\"),plotConfig);\n",
        "}\n",
        "\n",
        "function renderWatts(rows){\n",
        "  clearChart(\"chart-watts\");\n",
        "\n",
        "  const data=rows.map(r=>({\n",
        "    name:`${clean(r[COLUMNS.glider])} — ${clean(r[COLUMNS.mode])}`,\n",
        "    glider:clean(r[COLUMNS.glider]),\n",
        "    value:number(r[COLUMNS.watts])\n",
        "  })).filter(d=>d.value!==null).sort((a,b)=>a.value-b.value);\n",
        "\n",
        "  if(!data.length){\n",
        "    showChartMessage(\"chart-watts\",\"No power data available.\");\n",
        "    return;\n",
        "  }\n",
        "\n",
        "  Plotly.newPlot(\"chart-watts\",[{\n",
        "    type:\"bar\",\n",
        "    orientation:\"h\",\n",
        "    x:data.map(d=>d.value),\n",
        "    y:data.map(d=>d.name),\n",
        "    text:data.map(d=>d.value.toFixed(2)),\n",
        "    textposition:\"outside\",\n",
        "    marker:{color:data.map(d=>GLIDER_COLOR_MAP[d.glider])}\n",
        "  }],{\n",
        "    height:Math.max(320,data.length*28),\n",
        "    margin:{l:150,r:55,t:10,b:50},\n",
        "    paper_bgcolor:\"rgba(0,0,0,0)\",\n",
        "    plot_bgcolor:\"rgba(0,0,0,0)\",\n",
        "    font:{family:\"Atkinson Hyperlegible, Arial, sans-serif\",color:PLOT_COLORS.ink},\n",
        "    xaxis:{title:\"Power (W)\",gridcolor:PLOT_COLORS.line,zerolinecolor:PLOT_COLORS.lineStrong},\n",
        "    yaxis:{automargin:true}\n",
        "  },plotConfig);\n",
        "}\n",
        "\n",
        "function renderHeatmap(rows){\n",
        "  clearChart(\"chart-heatmap\");\n",
        "\n",
        "  const metric=document.getElementById(\"metric-select\").value;\n",
        "  const gliders=[...new Set(rows.map(r=>clean(r[COLUMNS.glider])).filter(Boolean))].sort();\n",
        "  const modes=[...new Set(rows.map(r=>clean(r[COLUMNS.mode])).filter(Boolean))].sort();\n",
        "\n",
        "  if(!gliders.length||!modes.length){\n",
        "    showChartMessage(\"chart-heatmap\",\"No data available for the selected filters.\");\n",
        "    return;\n",
        "  }\n",
        "\n",
        "  const matrix=gliders.map(g=>modes.map(m=>{\n",
        "    const values=rows.filter(r=>\n",
        "      clean(r[COLUMNS.glider])===g&&\n",
        "      clean(r[COLUMNS.mode])===m\n",
        "    ).map(r=>number(r[COLUMNS[metric]])).filter(v=>v!==null);\n",
        "\n",
        "    return values.length?values.reduce((a,b)=>a+b,0)/values.length:null;\n",
        "  }));\n",
        "\n",
        "  const labels={\n",
        "    wh_km:\"Wh/km\",\n",
        "    watts:\"Power (W)\",\n",
        "    wh_dive:\"Wh/dive\",\n",
        "    distance:\"km/dive\",\n",
        "    dive_duration:\"Dive duration (hr)\",\n",
        "    vertical_speed:\"Vertical speed (m/s)\"\n",
        "  };\n",
        "\n",
        "  document.getElementById(\"heatmap-label\").textContent=labels[metric]||metric;\n",
        "\n",
        "  Plotly.newPlot(\"chart-heatmap\",[{\n",
        "    type:\"heatmap\",\n",
        "    z:matrix,\n",
        "    x:modes,\n",
        "    y:gliders,\n",
        "    colorscale:\"Blues\",\n",
        "    hovertemplate:\"Glider: %{y}<br>Mode: %{x}<br>Value: %{z:.2f}<extra></extra>\",\n",
        "    colorbar:{title:labels[metric]||metric}\n",
        "  }],{\n",
        "    height:Math.max(320,gliders.length*42+100),\n",
        "    margin:{l:90,r:30,t:10,b:80},\n",
        "    paper_bgcolor:\"rgba(0,0,0,0)\",\n",
        "    plot_bgcolor:\"rgba(0,0,0,0)\",\n",
